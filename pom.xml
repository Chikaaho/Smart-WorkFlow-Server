<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.sw.ck</groupId>
    <artifactId>smart-workflow</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Smart-WorkFlow</name>
    <description>嵌入 Agent 的低代码 OA 系统后端基础框架</description>
    <url>https://github.com/your-org/smart-workflow</url>

    <modules>
        <!-- BOM 版本管理 -->
        <module>sw-dependencies</module>

        <!-- 内核层 -->
        <module>sw-framework</module>

        <!-- 基础能力层 -->
        <module>sw-basic</module>

        <!-- 业务层 -->
        <module>sw-biz</module>

        <!-- 启动入口 -->
        <module>sw-bootstrap</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <!--
        sw-module-dependencies 是子模块（parent 指向本 POM），若在此处把它当 BOM import 回来，
        会在构建模型阶段形成自引用循环（root -> import sw-module-dependencies -> parent=root）。
        因此版本管理的 BOM import 改为下放到每个实际消费依赖的子模块自己的 pom.xml 中声明。
    -->

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <source>${java.version}</source>
                        <target>${java.version}</target>
                        <encoding>UTF-8</encoding>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>3.4.4</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>repackage</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>3.5.0</version>
                    <dependencies>
                        <dependency>
                            <groupId>org.apache.maven.plugins</groupId>
                            <artifactId>maven-enforcer-rules</artifactId>
                            <version>3.5.0</version>
                        </dependency>
                    </dependencies>
                    <configuration>
                        <rules>
                            <dependencyConvergence/>
                        </rules>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
